{
  "manifest_version": 3,
  "name": "Screenshot to PDF",
  "version": "1.1",
  "description": "Capture automatique d'écran avec navigation et export PDF",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["jspdf.umd.min.js", "selector.html", "selector.css"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["selector.js"],
    "css": ["selector.css"],
    "run_at": "document_idle"
  }]
}